# =============================================================
# Server
# =============================================================
# Local dev uses 3000. Railway / Render / etc. set PORT for you.
PORT=3000

# Production cookie-secure flag flips on when this is "production".
# NODE_ENV=production

# =============================================================
# Database (Prisma + SQLite)
# =============================================================
# Local: file path is relative to prisma/schema.prisma.
DATABASE_URL="file:../data.db"
#
# Railway with a volume mounted at /data:
#   DATABASE_URL="file:/data/data.db"
#   UPLOADS_DIR="/data/uploads"

# Where uploaded photos/videos are stored on disk.
# Leave blank to keep them in <project>/uploads (the bundled prototype assets).
# In production point this at a persistent volume so user uploads survive
# redeploys.
# UPLOADS_DIR=

# =============================================================
# Admin auth
# =============================================================
# Generate the password hash once with:  npm run admin:hash -- "<your password>"
ADMIN_EMAIL=admin@topcrop.tz
ADMIN_PASSWORD_HASH=

# Long random string used to sign session cookies. CHANGE THIS for production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
